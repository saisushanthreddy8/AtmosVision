{
  "name": "AtmosVision AI - Tamil Nadu Live Weather & Crop Advisory",
  "short_name": "AtmosVision",
  "id": "com.atmosvision.app",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "background_color": "#F8FAF9",
  "theme_color": "#059669",
  "orientation": "any",
  "description": "Real-Time 38-District Live Weather, Meteorological GIS Radar, AI Weather Predictions, Soil Pedology, and Smart Crop Advisory Studio for Tamil Nadu.",
  "categories": [
    "weather",
    "agriculture",
    "productivity",
    "utilities"
  ],
  "lang": "en",
  "dir": "ltr",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.atmosvision.app",
      "url": "https://play.google.com/store/apps/details?id=com.atmosvision.app"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://atmos-vision-beta.vercel.app"
    }
  ],
  "launch_handler": {
    "client_mode": "auto"
  },
  "handle_links": "preferred",
  "file_handlers": [
    {
      "action": "/?source=file",
      "name": "Weather & Agro Data File",
      "accept": {
        "text/plain": [".txt", ".csv"],
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "/?source=share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+weather",
      "url": "/?query=%s"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "AtmosVision 38-District Live Radar Desktop Dashboard"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "AtmosVision Mobile Weather and Agro Advisory"
    }
  ],
  "shortcuts": [
    {
      "name": "AI Weather Forecast",
      "short_name": "Forecast",
      "description": "View AI Forward Weather Predictions for Tamil Nadu",
      "url": "/?tab=ai_forecast",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Crop Advisory & Calculator",
      "short_name": "Crops",
      "description": "Calculate Seed, Fertilizer & Crop Calendar",
      "url": "/?tab=crop_suggestions",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
